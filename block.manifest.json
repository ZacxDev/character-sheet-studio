{
  "$schema": "https://civitai.com/schemas/app-block/v1.json",
  "blockId": "character-sheet-studio",
  "version": "0.1.0",
  "name": "Character Sheet Studio",
  "type": "block",
  "scopes": [
    "ai:write:budgeted"
  ],
  "scopeJustifications": {
    "ai:write:budgeted": "Runs image generations on the user's behalf, spending from the per-generation Buzz budget the page grants."
  },
  "page": {
    "path": "/",
    "title": "Character Sheet Studio",
    "icon": "bolt",
    "buzzBudgetPerGen": 300
  },
  "iframe": {
    "minHeight": 600,
    "maxHeight": 4000,
    "resizable": true,
    "sandbox": "allow-scripts allow-forms",
    "src": "https://character-sheet-studio.civit.ai/"
  },
  "contentRating": "g",
  "bootSkeleton": true,
  "minApiVersion": "1.0",
  "buildCommand": "npm run build",
  "outputDir": "dist"
}
